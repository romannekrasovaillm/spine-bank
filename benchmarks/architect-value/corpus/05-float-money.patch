+"""Сумма платежей (корпусный дефект, класс S-01 — деньги в float).
+
+Дефект ожидается НЕ поймённым: правила класса S-01 в реестре кейса нет.
+"""
+
+
+def total(amounts):
+    acc = 0.0
+    for a in amounts:
+        acc += float(a)
+    return acc
