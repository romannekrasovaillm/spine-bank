# Сборка (target/ на любом уровне — включая решения в кейсах)
target/
**/*.rs.bk

# Python-кэш генераторов скиллов
__pycache__/
*.pyc

# Рабочий журнал разработки — локальный, в публичный репозиторий не входит
/AGENTS.local.md

# Локальные файлы окружения и ключей
.env
*.pem
*.key

# Служебные каталоги сессии харнесса и песочницы сборки (не входят в коммит)
.theseus/
.codewhale/
.qwen/
.playwright-mcp/
.cargo/
.cargo-tmp/
target-check/
.target-fresh/

# рабочие пакеты handoff (генерируются per-run, не для VCS)
.arch-handoff/

# ...кроме .arch-handoff КЕЙСА: маршрут (ROUTE.lock), план отката и отчёт
# репетиции — часть кейса, их требует профиль Evidence Bundle. Без них клон
# репозитория даёт красный кейс: артефакт «есть» только в рабочем дереве
# автора. Рабочие артефакты прогонов (журнал вызовов, измерение redteam)
# остаются вне VCS — они принадлежат тому, кто их снял.
!кейсы/*/.arch-handoff/
!кейсы/*/.arch-handoff/**
кейсы/*/.arch-handoff/mcp-calls.jsonl
кейсы/*/.arch-handoff/redteam.json

# вывод демо-прогонов (генерируется, не для VCS)
registry-out/
banking/demos/cli-from-claude-code/scenario1-headless/stderr.log

# бинарь в deploy-kit — релиз-артефакт (GitHub Release), не для VCS
deploy-kit/arch-be

# Локальная выгрузка релизов и офлайн-бандлов (scripts/make_offline_bundle.sh)
dist/

# Platform V arch-bench: тяжёлые прогоны (ячейки/логи) — в VCS не входят
benchmarks/platformv-arch-bench/runs/
